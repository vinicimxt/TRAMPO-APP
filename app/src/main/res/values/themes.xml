<resources>
 <style name="Base.Theme.TRAMPO" parent="Theme.Material3.DayNight.NoActionBar">
  <item name="colorPrimary">@color/brand</item><item name="colorOnPrimary">@color/on_brand</item>
  <item name="colorSecondary">@color/secondary</item><item name="colorSurface">@color/surface</item>
  <item name="colorOnSurface">@color/ink</item><item name="colorOnSurfaceVariant">@color/muted</item>
  <item name="colorOutline">@color/outline</item><item name="colorError">@color/error</item>
  <item name="android:windowBackground">@color/page</item><item name="android:colorAccent">@color/brand</item>
  <item name="android:fontFamily">sans</item>
 </style>
 <style name="Theme.TRAMPO" parent="Base.Theme.TRAMPO" />
 <style name="Page">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">match_parent</item>
  <item name="android:orientation">vertical</item><item name="android:padding">@dimen/page_padding</item>
  <item name="android:background">@color/page</item>
 </style>
 <style name="BaseTitle">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
  <item name="android:textSize">28sp</item><item name="android:textStyle">bold</item>
  <item name="android:textColor">@color/ink</item><item name="android:layout_marginBottom">@dimen/space_medium</item>
 </style>
 <style name="Title" parent="BaseTitle" />
 <style name="SectionTitle" parent="Title"><item name="android:textSize">20sp</item><item name="android:layout_marginBottom">12dp</item></style>
 <style name="Body">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
  <item name="android:textSize">16sp</item><item name="android:textColor">@color/muted</item>
  <item name="android:lineSpacingExtra">4dp</item><item name="android:layout_marginBottom">12dp</item>
 </style>
 <style name="Price" parent="Body"><item name="android:textSize">24sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/brand</item></style>
 <style name="Label" parent="Body"><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/ink</item><item name="android:layout_marginTop">12dp</item><item name="android:layout_marginBottom">8dp</item></style>
 <style name="Message" parent="Body"><item name="android:padding">16dp</item><item name="android:background">@drawable/bg_message</item><item name="android:accessibilityLiveRegion">polite</item></style>
 <style name="Badge" parent="Body"><item name="android:layout_width">wrap_content</item><item name="android:padding">10dp</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/brand</item><item name="android:background">@drawable/bg_badge</item></style>
 <style name="Action" parent="Widget.Material3.Button">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
  <item name="android:minHeight">@dimen/touch_height</item><item name="android:layout_marginTop">8dp</item>
  <item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item><item name="cornerRadius">16dp</item>
  <item name="iconGravity">textStart</item><item name="iconPadding">12dp</item>
 </style>
 <style name="SecondaryAction" parent="Widget.Material3.Button.OutlinedButton">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
  <item name="android:minHeight">@dimen/touch_height</item><item name="android:layout_marginTop">8dp</item>
  <item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item><item name="cornerRadius">16dp</item><item name="iconGravity">textStart</item>
 </style>
 <style name="QuietAction" parent="Widget.Material3.Button.TextButton">
  <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
  <item name="android:minHeight">48dp</item><item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item><item name="iconGravity">textStart</item>
 </style>
 <style name="DangerAction" parent="SecondaryAction"><item name="android:textColor">@color/error</item><item name="iconTint">@color/error</item><item name="strokeColor">@color/error</item></style>
 <style name="Field">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
  <item name="android:minHeight">@dimen/touch_height</item><item name="android:singleLine">true</item>
  <item name="android:saveEnabled">false</item><item name="android:textSize">16sp</item>
  <item name="android:textColor">@color/ink</item><item name="android:textColorHint">@color/muted</item>
  <item name="android:background">@drawable/bg_field</item><item name="android:padding">16dp</item><item name="android:layout_marginBottom">8dp</item>
 </style>
 <style name="Card" parent="Widget.Material3.CardView.Elevated">
  <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
  <item name="android:layout_marginBottom">16dp</item><item name="cardCornerRadius">@dimen/corner_radius</item>
  <item name="cardBackgroundColor">@color/surface</item><item name="cardElevation">0dp</item><item name="strokeColor">@color/outline</item><item name="strokeWidth">1dp</item>
 </style>
</resources>
