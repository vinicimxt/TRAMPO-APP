<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/root" style="@style/Page" android:layout_height="wrap_content">
<com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/QuietAction" android:text="@string/back" />
<TextView style="@style/Title" android:text="@string/change_password" />
<TextView style="@style/Label" android:labelFor="@id/current_password" android:text="@string/current_password" />
<EditText android:id="@+id/current_password" style="@style/Field" android:inputType="textPassword" android:maxLength="1024" android:importantForAutofill="no" />
<TextView style="@style/Label" android:labelFor="@id/new_password" android:text="@string/new_password" />
<EditText android:id="@+id/new_password" style="@style/Field" android:inputType="textPassword" android:maxLength="1024" android:importantForAutofill="no" />
<TextView style="@style/Label" android:labelFor="@id/confirm_password" android:text="@string/confirm_password" />
<EditText android:id="@+id/confirm_password" style="@style/Field" android:inputType="textPassword" android:maxLength="1024" android:importantForAutofill="no" />
<TextView style="@style/Body" android:text="@string/password_hint" />
<ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="@string/loading" />
<TextView android:id="@+id/message" style="@style/Message" />
<com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Action" android:text="@string/change_password" />
</LinearLayout></ScrollView>
