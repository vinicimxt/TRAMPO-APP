<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/root" style="@style/Page" android:layout_height="wrap_content">
<com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/QuietAction" android:text="@string/back" />
<TextView style="@style/Title" android:text="@string/support" />
<TextView style="@style/Body" android:text="@string/support_hint" />
<TextView style="@style/Label" android:labelFor="@id/subject" android:text="@string/subject" />
<EditText android:id="@+id/subject" style="@style/Field" android:inputType="textCapSentences" android:maxLength="150" android:importantForAutofill="no" />
<TextView style="@style/Label" android:labelFor="@id/support_message" android:text="@string/support_message" />
<EditText android:id="@+id/support_message" style="@style/Field" android:inputType="textMultiLine|textCapSentences" android:maxLength="1000" android:importantForAutofill="no" android:singleLine="false" android:minLines="3" android:gravity="top|start" />
<ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="@string/loading" />
<TextView android:id="@+id/message" style="@style/Message" />
<com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Action" android:text="@string/send_support" />
</LinearLayout></ScrollView>
