<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/root" style="@style/Page" android:layout_height="wrap_content">
<com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/QuietAction" android:text="@string/back" />
<TextView style="@style/Title" android:text="@string/my_profile" />
<ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="@string/loading" />
<TextView android:id="@+id/message" style="@style/Message" />
<TextView style="@style/Label" android:labelFor="@id/full_name" android:text="@string/full_name" />
<EditText android:id="@+id/full_name" style="@style/Field" android:inputType="textPersonName" android:maxLength="100" android:importantForAutofill="no" />
<TextView style="@style/Label" android:text="@string/email_readonly" />
<TextView android:id="@+id/profile_email" style="@style/Body" />
<TextView style="@style/Label" android:labelFor="@id/phone" android:text="@string/phone_optional" />
<EditText android:id="@+id/phone" style="@style/Field" android:inputType="phone" android:maxLength="20" android:importantForAutofill="no" />
<com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Action" android:text="@string/save_profile" />
<com.google.android.material.button.MaterialButton android:id="@+id/change_password" style="@style/SecondaryAction" android:text="@string/change_password" />
<com.google.android.material.button.MaterialButton android:id="@+id/retry" style="@style/QuietAction" android:text="@string/refresh" />
</LinearLayout></ScrollView>
